# Local path or host-mounted SMB/NFS/ZFS dataset containing music.
SURROUNDCORE_MEDIA=/srv/surroundcore/media
SURROUNDCORE_DATA=/var/lib/surroundcore
SURROUNDCORE_SOURCES=/srv/surroundcore/sources
SURROUNDCORE_CACHE=/var/cache/surroundcore
SURROUNDCORE_CACHE_MAX_GB=0
SURROUNDCORE_CACHE_MIN_FREE_GB=5
SURROUNDCORE_MEDIA_GID=1000

# Generate a strong random token for Core <-> endpoint control.
SURROUNDCORE_TOKEN=change-me

# Public/reachable URL used in media stream URLs sent to endpoints and Sonos.
# install.sh fills this with the machine's primary address.
SURROUNDCORE_PUBLIC_URL=

# Endpoint agent registration target. Local CT/VM default is the Core itself.
SURROUNDCORE_CORE_URL=http://127.0.0.1:8080
SURROUNDCORE_ENDPOINT_NAME="SurroundCore Local HDMI"
SURROUNDCORE_DEFAULT_DEVICE=default
