# Local path or host-mounted SMB/NFS/ZFS dataset containing music.
SURROUNDCORE_MEDIA=/srv/surroundcore/media
SURROUNDCORE_DATA=/var/lib/surroundcore
SURROUNDCORE_SOURCES=/srv/surroundcore/sources
SURROUNDCORE_CACHE=/var/cache/surroundcore
SURROUNDCORE_CACHE_MAX_GB=0
SURROUNDCORE_CACHE_MIN_FREE_GB=5
SURROUNDCORE_MEDIA_GID=1000

# Generate a strong random token for Core <-> endpoint control.
SURROUNDCORE_TOKEN=change-me

# Scoped credential used by ControlMac clients; never use the Core master key in ControlMac.
SURROUNDCORE_CONTROLMAC_TOKEN=change-me

# Public/reachable URL used in media stream URLs sent to endpoints and Sonos.
# install.sh fills this with the machine's primary address.
SURROUNDCORE_PUBLIC_URL=

# Endpoint agent registration target. Local CT/VM default is the Core itself.
SURROUNDCORE_CORE_URL=http://127.0.0.1:8080
# Optional sanitized hardware helper (used by Proxmox CT installs).
SURROUNDCORE_HARDWARE_URL=
SURROUNDCORE_ENDPOINT_NAME="SurroundCore Local HDMI"
SURROUNDCORE_DEFAULT_DEVICE=default

# Optional licensed AIRIA decoder/helper path inside the Core container.
SURROUNDCORE_AIRIA_DECODER=

# Direct optical / disc-image / MiniDisc ingest service (TCP 8082).
SURROUNDCORE_INGEST_DATA=/var/lib/surroundcore/ingest
SURROUNDCORE_INGEST_LIBRARY=/srv/surroundcore/sources/ingest
SURROUNDCORE_AUTO_RIP=true
SURROUNDCORE_AUTO_NETMD=true
SURROUNDCORE_INGEST_EJECT=true
SURROUNDCORE_INGEST_KEEP_UPLOADS=false
SURROUNDCORE_INGEST_POLL_SECONDS=8
SURROUNDCORE_INGEST_MAX_UPLOAD_GB=0

# Optional MakeMKV Linux installation for protected/complex Blu-ray access.
# The software is not redistributed by SurroundCore; mount a user-installed tree here.
SURROUNDCORE_MAKEMKV_DIR=/opt/surroundcore/makemkv
SURROUNDCORE_MAKEMKVCON=/opt/makemkv/makemkvcon

# User-supplied official Spotify Soloist binary (not redistributed).
SURROUNDCORE_SPOTIFY_DIR=/opt/surroundcore/spotify
SURROUNDCORE_SPOTIFY_SOLOIST=/opt/spotify/soloist

# Native AirPlay 2 realtime sender (airplay-cli v0.5.3 proven with Sonos)
SURROUNDCORE_AIRPLAY_DIR=/opt/surroundcore/airplay
SURROUNDCORE_AIRPLAY_CLI=/opt/airplay/cliairplay-linux-x86_64
# Optional; blank auto-selects the local IPv4 route.
SURROUNDCORE_AIRPLAY_BIND_IP=
# Remote transport boundary. Leave unconfigured until the carrier is chosen.
SURROUNDCORE_REMOTE_MODE=unconfigured
